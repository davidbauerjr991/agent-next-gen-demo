// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`composition under every built-in profile (P-LAYOUT gate) > aifirst: Home 1`] = `
"header
  div[data-slot=brand-mark]
  button[name=Search]
  button[name=WEM]
  button[name=Agent Chat]
  button[name=Schedule]
  button[name=Notifications, # unread]
  button[name=View All Apps]
  button[name=Agent Status and More]
aside[aria-label=Main navigation]
  nav[aria-label=Navigation menu]
  div[data-slot=assignment-card]
  div[data-slot=assignment-card]
  div[data-slot=assignment-card]
  nav[aria-label=Navigation menu]
    button[name=Home]
    button[name=Settings]
div[data-slot=content-card]
  div[data-home-header=]
    button[data-slot=queue-chip]
    div[role=tablist][aria-label=Home][data-slot=home-tabs]
      button[name=Dashboard]
      button[name=Customers]
      button[name=Accounts]
      button[name=Tickets]
  nav[aria-label=Pagination]
    button[name=First page]
    button[name=Previous page]
    button[name=Next page]
    button[name=Last page]
  div[role=tablist]
    button[name=Overview]
    button[name=Contacts]
    button[name=Detail]
    button[name=Directory]
    button[name=Tasks]
    button[name=Notes]
    button[name=Accounts]
    button[name=Tickets]
  div[role=region]
  div[role=region]
  div[role=region]
  div[data-home-layout=twoColumn]
    div[data-home-section=activity][data-home-scroll=feed]
      div[data-activity-feed=*]
        div[data-feed-views=*]
    div[data-canvas-region=reference][data-docked=*]
      div[data-home-column=side]
        div[data-home-section=queue]
          div[data-home-card=queueList]
        div[data-home-section=performance]
  div[data-slot=page-right-host]
div[data-slot=voice-bar-bottom]
div[role=region][aria-label=Notifications (F#)]"
`;

exports[`composition under every built-in profile (P-LAYOUT gate) > aifirst: a call under AI display panel 1`] = `
"header
  div[data-slot=brand-mark]
  button[name=Search]
  button[name=WEM]
  button[name=Agent Chat]
  button[name=Schedule]
  button[name=Notifications, # unread]
  button[name=View All Apps]
  button[name=Agent Status and More]
aside[aria-label=Main navigation]
  nav[aria-label=Navigation menu]
  div[data-slot=assignment-card]
  div[data-slot=assignment-card]
  div[data-slot=assignment-card]
  div[data-slot=assignment-card]
  nav[aria-label=Navigation menu]
    button[name=Home]
    button[name=Settings]
div[data-slot=content-card]
  div[data-slot=record-header]
    span[data-slot=header-add-channel]
    div[data-slot=record-session-row]
  div[data-main-thread=*]
    span[data-slot=thread-crossfade]
    div[role=region]
      div[data-slot=content-stack]
  div[data-slot=right-panel]
    div[role=region][aria-label=Copilot]
      div[data-slot=details-panel-body]
        div[data-canvas-cell=real-time-summary]
          div[data-slot=real-time-summary]
            div[role=region]
        div[data-canvas-cell=journey-summary]
          div[data-slot=journey-summary]
            div[role=region]
        div[data-canvas-cell=customer-info]
          div[data-slot=customer-info-card]
            div[role=region]
        div[data-slot=ai-feed]
          div[data-slot=next-best-action]
            div[role=region]
      div[data-slot=composer-fade]
      div[data-slot=copilot-dock]
        div[data-slot=copilot-composer][data-placement=panel]
          div[data-slot=copilot-chips]
            span[data-slot=copilot-chip-pinned]
            div[data-slot=copilot-chips-refresh]
  div[data-slot=page-right-host]
div[data-slot=voice-bar-bottom]
  div[data-slot=voice-bar][data-placement=bottom]
div[role=region][aria-label=Notifications (F#)]"
`;

